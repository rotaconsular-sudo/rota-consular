// Rota Consular — schema inicial
// Ver PROJECT.md para o desenho completo do wizard e do fluxo de análise.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  applications Application[]
  sessions     Session[]
}

// Login sem senha: um link de acesso de uso único, válido por 15 minutos.
// Guardamos só o hash do token — o valor em texto puro só existe no e-mail
// enviado ao usuário.
model VerificationToken {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Sessão de login, com estado no banco (não um JWT autocontido) — permite
// revogar sessões individualmente e não depende só de um segredo compartilhado.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Um "caso" de visto por tentativa — o usuário pode ter mais de um
// (ex: reaplicar depois de uma recusa).
model Application {
  id             String            @id @default(cuid())
  user           User              @relation(fields: [userId], references: [id])
  userId         String
  status         ApplicationStatus @default(EM_ANDAMENTO)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  answers        Answer[]
  documents      Document[]
  analysisResult AnalysisResult?
}

enum ApplicationStatus {
  EM_ANDAMENTO
  ANALISE_PRONTA
  CONCLUIDA
}

// Uma resposta por etapa do wizard — permite editar uma etapa
// isoladamente sem afetar as demais.
model Answer {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  step          WizardStep
  data          Json
  updatedAt     DateTime    @updatedAt

  @@unique([applicationId, step])
}

enum WizardStep {
  DADOS_PESSOAIS
  SITUACAO_PROFISSIONAL
  HISTORICO_VIAGENS
  MOTIVO_VIAGEM
}

model Document {
  id            String       @id @default(cuid())
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  type          DocumentType
  url           String
  fileName      String
  uploadedAt    DateTime     @default(now())
}

enum DocumentType {
  IDENTIDADE
  COMPROVANTE_RENDA
  EXTRATO_BANCARIO
  VINCULO_EMPREGATICIO
  ITINERARIO
  OUTRO
}

// Saída do motor de análise (Claude API) — apoio à decisão, nunca veredito.
model AnalysisResult {
  id             String      @id @default(cuid())
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId  String      @unique
  readinessScore Int
  checklist      Json
  alerts         Json
  createdAt      DateTime    @default(now())
}
