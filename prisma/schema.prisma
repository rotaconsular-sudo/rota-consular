// Rota Consular — schema inicial
// Ver PROJECT.md para o desenho completo do wizard e do fluxo de análise.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  createdAt    DateTime      @default(now())
  applications Application[]
  sessions     Session[]
  compras      Compra[]
  acessos      Acesso[]
}

// Login sem senha: um link de acesso de uso único, válido por 15 minutos.
// Guardamos só o hash do token — o valor em texto puro só existe no e-mail
// enviado ao usuário.
model VerificationToken {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Sessão de login, com estado no banco (não um JWT autocontido) — permite
// revogar sessões individualmente e não depende só de um segredo compartilhado.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Um "caso" de visto por tentativa — o usuário pode ter mais de um
// (ex: reaplicar depois de uma recusa).
//
// userId é opcional: o funil gratuito começa anônimo (sem login), só com
// email/whatsapp capturados na criação. Acesso nesse estágio é validado por
// accessTokenHash (cookie/token na URL, ver src/lib/applications.ts), não
// por sessão. Quando o pagamento é aprovado, a Application é linkada a um
// User (criado/reaproveitado pelo email).
model Application {
  id              String            @id @default(cuid())
  user            User?             @relation(fields: [userId], references: [id])
  userId          String?
  email           String?
  whatsapp        String?
  accessTokenHash String?           @unique
  status          ApplicationStatus @default(EM_ANDAMENTO)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  answers         Answer[]
  documents       Document[]
  analysisResult  AnalysisResult?
  payments        Payment[]
}

enum ApplicationStatus {
  EM_ANDAMENTO
  ANALISE_PRONTA
  CONCLUIDA
}

// Uma resposta por etapa do wizard — permite editar uma etapa
// isoladamente sem afetar as demais.
model Answer {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  step          WizardStep
  data          Json
  updatedAt     DateTime    @updatedAt

  @@unique([applicationId, step])
}

enum WizardStep {
  DADOS_PESSOAIS
  SITUACAO_PROFISSIONAL
  HISTORICO_VIAGENS
  MOTIVO_VIAGEM
  // Substitui as 4 etapas acima no funil gratuito: quiz de 1 pergunta por
  // tela (ver src/components/Quiz.tsx), todas as respostas num Answer só.
  // As 4 antigas ficam no enum e nas páginas (não removidas) mas saem de
  // uso — só existem casos antigos que já as usaram antes dessa migração.
  PERFIL
}

model Document {
  id            String       @id @default(cuid())
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  type          DocumentType
  url           String
  fileName      String
  uploadedAt    DateTime     @default(now())
}

enum DocumentType {
  IDENTIDADE
  COMPROVANTE_RENDA
  EXTRATO_BANCARIO
  VINCULO_EMPREGATICIO
  ITINERARIO
  OUTRO
}

// Saída do motor de análise (Claude API) — apoio à decisão, nunca veredito.
model AnalysisResult {
  id             String      @id @default(cuid())
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId  String      @unique
  readinessScore Int
  checklist      Json
  alerts         Json
  createdAt      DateTime    @default(now())
}

// Desbloqueia o checklist completo (freemium: score é grátis). Uma
// Application pode ter mais de um Payment se uma tentativa falhar/expirar e
// a pessoa tentar de novo. "Pago" = existe algum Payment com status
// APPROVED, sem campo denormalizado.
model Payment {
  id             String        @id @default(cuid())
  application    Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId  String
  mpPreferenceId String
  mpPaymentId    String?       @unique
  status         PaymentStatus @default(PENDING)
  amountCents    Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────
// Loja de produtos + área de membros
//
// O catálogo saiu de src/lib/products.ts (código) pra cá, pra ter admin.
// O fluxo freemium (model Payment, acima) é outro produto, outra jornada,
// e continua separado — não mexer nele.
//
//   Produto ──< ProdutoConteudo >── Conteudo
//      │
//      └──< CompraItem >── Compra ──> User
//                  └──────> Acesso ──> User   (direito de acesso já resolvido)
// ─────────────────────────────────────────────────────────────────────────

// Item vendável (produto principal ou order bump no checkout).
model Produto {
  id                String      @id @default(cuid())
  slug              String      @unique
  nome              String
  descricao         String?
  precoCents        Int
  tipo              ProdutoTipo @default(PRINCIPAL)
  // Quantos dias o acesso dura a partir da compra. null = não expira.
  // Produtos de visto americano = 365.
  duracaoDias       Int?
  // Categoria a que o produto pertence (slug livre, ex.: "roteiros-eua").
  categoria         String?
  // "Leve também" abaixo do conteúdo comprado mostra produtos DESTA
  // categoria. Se vazio, usa a própria `categoria`.
  promoverCategoria String?
  ativo             Boolean     @default(true)
  ordem             Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  conteudos ProdutoConteudo[]
  itens     CompraItem[]
  acessos   Acesso[]
}

enum ProdutoTipo {
  PRINCIPAL
  ORDER_BUMP
}

// Unidade de conteúdo entregue na área de membros. Os campos de payload são
// mutuamente exclusivos: preenche só o que o `tipo` pede.
model Conteudo {
  id          String       @id @default(cuid())
  titulo      String
  descricao   String? // texto em Markdown, mostrado abaixo do conteúdo
  tipo        ConteudoTipo
  videoUrl    String? // VIDEO   — URL do YouTube não-listado
  blobUrl     String? // PDF     — URL do arquivo no Vercel Blob (privado)
  arquivoNome String? // PDF     — nome original, pro download
  markdown    String? // ROTEIRO — corpo em Markdown
  link        String? // LINK    — URL externa
  ativo       Boolean      @default(true)
  ordem       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  produtos ProdutoConteudo[]
}

enum ConteudoTipo {
  VIDEO
  PDF
  ROTEIRO
  LINK
}

// N↔N: comprar `produto` libera `conteudo`. Um conteúdo pode ser liberado
// por vários produtos (ex.: o mesmo checklist entra no principal e num bump).
model ProdutoConteudo {
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId  String
  conteudo   Conteudo @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  conteudoId String

  @@id([produtoId, conteudoId])
}

// Um pagamento (uma passada pelo checkout), com suas linhas.
model Compra {
  id             String       @id @default(cuid())
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  mpPreferenceId String?
  mpPaymentId    String?      @unique
  status         CompraStatus @default(PENDENTE)
  valorCents     Int
  // Payload cru do pagamento do Mercado Pago, pra conferência/suporte.
  raw            Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  itens   CompraItem[]
  acessos Acesso[]
}

enum CompraStatus {
  PENDENTE
  APROVADA
  ESTORNADA
  REJEITADA
}

model CompraItem {
  id         String  @id @default(cuid())
  compra     Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  compraId   String
  produto    Produto @relation(fields: [produtoId], references: [id])
  produtoId  String
  precoCents Int
}

// Direito de acesso já resolvido — a fonte da verdade pra "essa pessoa pode
// ver esse produto?". Materializado (não derivado de Compra) pra permitir
// concessão manual/cortesia, expiração e revogação sem apagar histórico.
// Um registro por (user, produto): recompra estende `expiraEm`.
model Acesso {
  id         String       @id @default(cuid())
  user       User         @relation(fields: [userId], references: [id])
  userId     String
  produto    Produto      @relation(fields: [produtoId], references: [id])
  produtoId  String
  origem     AcessoOrigem @default(COMPRA)
  compra     Compra?      @relation(fields: [compraId], references: [id])
  compraId   String?
  expiraEm   DateTime? // null = não expira
  revogadoEm DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([userId, produtoId])
}

enum AcessoOrigem {
  COMPRA
  MANUAL
  CORTESIA
}
